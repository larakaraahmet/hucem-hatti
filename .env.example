# HüCem Hattı — Ortam Değişkenleri
# Bu dosyayı kopyalayıp .env olarak kaydet: cp .env.example .env

# ── Veritabanı ─────────────────────────────────────────────────────────────────
# PostgreSQL bağlantı dizesi
DATABASE_URL=postgresql://lara@localhost:5432/football

# ── Anthropic API (AI içgörüsü için, opsiyonel) ─────────────────────────────────
# https://console.anthropic.com adresinden al
ANTHROPIC_API_KEY=sk-ant-...

# ── Dış Veri Kaynakları ─────────────────────────────────────────────────────────
# football-data.org API (kulüp ligi fikstürleri için, ücretsiz)
# Kayıt: https://www.football-data.org/client/register
FOOTBALL_DATA_API_KEY=

# API-Football v3 (oyuncu kulüp bilgisi — ingest_club_info.py)
# Kayıt: https://www.api-football.com veya https://rapidapi.com/api-sports/api/api-football
# Ücretsiz plan: 100 istek/gün, 10 istek/dakika
API_FOOTBALL_KEY=

# ── Frontend (opsiyonel) ────────────────────────────────────────────────────────
# Boş bırakılırsa Vite proxy kullanılır
# VITE_API_URL=http://localhost:8000
